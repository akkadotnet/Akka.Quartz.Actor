<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <!-- Quartz 3 reads binary blobs with BinaryFormatter, which .NET 9+ removed from the runtime. The unsupported
         System.Runtime.Serialization.Formatters package restores it for this offline, trusted-backup-only tool. -->
    <EnableUnsafeBinaryFormatterSerialization>true</EnableUnsafeBinaryFormatterSerialization>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../shared/StoreConnection.cs" Link="StoreConnection.cs" />
    <Compile Include="../shared/StoreSchema.cs" Link="StoreSchema.cs" />
    <PackageReference Include="Microsoft.Data.SqlClient" />
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <PackageReference Include="Npgsql" />
    <PackageReference Include="Quartz" />
    <PackageReference Include="Quartz.Serialization.Json" />
    <PackageReference Include="System.Runtime.Serialization.Formatters" />
  </ItemGroup>
</Project>
